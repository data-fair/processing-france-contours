{
  "type": "object",
  "layout": "tabs",
  "required": [
    "datasetMode"
  ],
  "$defs": {
    "level": {
      "type": "string",
      "title": "Niveau",
      "oneOf": [
        {
          "const": "region",
          "title": "Régions"
        },
        {
          "const": "departement",
          "title": "Départements"
        },
        {
          "const": "arrondissement",
          "title": "Arrondissements départementaux"
        },
        {
          "const": "canton",
          "title": "Cantons (à partir de 2020)"
        },
        {
          "const": "epci",
          "title": "EPCI"
        },
        {
          "const": "commune",
          "title": "Communes"
        },
        {
          "const": "arrondissement-municipal",
          "title": "Arrondissements municipaux (à partir de 2020)"
        },
        {
          "const": "iris",
          "title": "IRIS"
        }
      ]
    },
    "simplifyLevel": {
      "type": "string",
      "title": "Simplification",
      "default": "medium",
      "oneOf": [
        {
          "const": "full",
          "title": "Aucune (tracés d'origine)"
        },
        {
          "const": "medium",
          "title": "Moyenne (~100 m)"
        },
        {
          "const": "simple",
          "title": "Forte (~1 km)"
        }
      ]
    },
    "year": {
      "type": "integer",
      "title": "Millésime",
      "enum": [
        2026,
        2025,
        2024,
        2023,
        2022,
        2021,
        2020,
        2019,
        2018,
        2017
      ]
    }
  },
  "allOf": [
    {
      "title": "Jeux de données",
      "properties": {
        "datasetMode": {
          "type": "string",
          "default": "create",
          "layout": "none"
        }
      },
      "discriminator": {
        "propertyName": "datasetMode"
      },
      "oneOfLayout": {
        "label": "Action"
      },
      "oneOf": [
        {
          "title": "Créer les jeux de données",
          "required": [
            "datasetMode"
          ],
          "properties": {
            "datasetMode": {
              "type": "string",
              "const": "create"
            },
            "years": {
              "type": "array",
              "title": "Millésimes",
              "default": [
                2026
              ],
              "minItems": 1,
              "description": "Un jeu de données est créé par millésime et par ligne. Les millésimes passés ne sont jamais republiés par l'IGN : ils ne sont créés qu'une fois. Traités ensemble, les plus anciens reprennent les libellés les plus complets des plus récents.",
              "items": {
                "$ref": "#/$defs/year"
              }
            },
            "datasetIdPrefix": {
              "type": "string",
              "title": "Préfixe des slugs",
              "default": "france-contours",
              "description": "Chaque jeu est créé avec le slug `<préfixe>-<millésime>-<niveau>-<simplification>` (ex : `france-contours-2026-commune-medium`). Si un jeu de données du compte porte déjà ce slug, il est réutilisé plutôt que dupliqué. Les jeux ne sont créés qu'une fois : la configuration bascule ensuite en mise à jour."
            },
            "createAll": {
              "type": "boolean",
              "title": "Tous les niveaux dans toutes les simplifications",
              "default": false,
              "description": "Pour un lancement initial : produit toutes les combinaisons niveau × simplification pour chaque millésime choisi. Les cantons et les arrondissements municipaux n'existent qu'à partir de 2020."
            },
            "datasets": {
              "type": "array",
              "title": "Jeux de données à créer",
              "description": "Une ligne par niveau et simplification, déclinée pour chaque millésime choisi. Un même niveau peut figurer plusieurs fois avec des simplifications différentes.",
              "layout": {
                "if": "!parent.data.createAll",
                "listEditMode": "inline",
                "messages": {
                  "addItem": "Ajouter un jeu de données"
                }
              },
              "default": [
                {
                  "level": "region",
                  "simplifyLevel": "medium"
                },
                {
                  "level": "departement",
                  "simplifyLevel": "medium"
                },
                {
                  "level": "epci",
                  "simplifyLevel": "medium"
                },
                {
                  "level": "commune",
                  "simplifyLevel": "medium"
                }
              ],
              "items": {
                "type": "object",
                "required": [
                  "level",
                  "simplifyLevel"
                ],
                "layout": [
                  {
                    "children": [
                      "level"
                    ],
                    "cols": 6
                  },
                  {
                    "children": [
                      "simplifyLevel"
                    ],
                    "cols": 6
                  }
                ],
                "properties": {
                  "level": {
                    "$ref": "#/$defs/level"
                  },
                  "simplifyLevel": {
                    "$ref": "#/$defs/simplifyLevel"
                  }
                }
              }
            }
          }
        },
        {
          "title": "Mettre à jour les jeux de données",
          "required": [
            "datasetMode"
          ],
          "properties": {
            "datasetMode": {
              "type": "string",
              "const": "update"
            },
            "datasets": {
              "type": "array",
              "title": "Jeux de données à mettre à jour",
              "description": "Une ligne par jeu de données, remplie automatiquement après la création.",
              "layout": {
                "listEditMode": "inline",
                "messages": {
                  "addItem": "Ajouter un jeu de données"
                }
              },
              "items": {
                "type": "object",
                "required": [
                  "year",
                  "level",
                  "simplifyLevel",
                  "dataset"
                ],
                "layout": [
                  {
                    "children": [
                      "year"
                    ],
                    "cols": 2
                  },
                  {
                    "children": [
                      "level"
                    ],
                    "cols": 3
                  },
                  {
                    "children": [
                      "simplifyLevel"
                    ],
                    "cols": 3
                  },
                  {
                    "children": [
                      "dataset"
                    ],
                    "cols": 4
                  }
                ],
                "properties": {
                  "year": {
                    "$ref": "#/$defs/year"
                  },
                  "level": {
                    "$ref": "#/$defs/level"
                  },
                  "simplifyLevel": {
                    "$ref": "#/$defs/simplifyLevel"
                  },
                  "dataset": {
                    "type": "object",
                    "title": "Jeu de données existant",
                    "required": [
                      "id"
                    ],
                    "layout": {
                      "getItems": {
                        "url": "${context.dataFairUrl}/api/v1/datasets?select=id,title&size=50&${context.ownerFilter}&raw=true",
                        "qSearchParam": "q",
                        "itemsResults": "data.results",
                        "itemTitle": "item.title",
                        "itemKey": "item.id"
                      }
                    },
                    "properties": {
                      "id": {
                        "type": "string",
                        "title": "Identifiant"
                      },
                      "title": {
                        "type": "string",
                        "title": "Titre"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "Paramètres",
      "properties": {
        "combineCommunesAndPlm": {
          "type": "boolean",
          "title": "Fusionner communes et arrondissements municipaux (PLM)",
          "description": "Pour le niveau commune, remplace les polygones de Paris, Lyon et Marseille par leurs arrondissements municipaux afin d'obtenir un découpage jointif sans superposition. La commune de rattachement est conservée dans la colonne `INSEE_RATT`.",
          "default": true
        },
        "enableVtPrepare": {
          "type": "boolean",
          "title": "Pré-calculer les tuiles vectorielles",
          "description": "Active la capacité `vtPrepare` sur la géométrie : Data Fair génère les tuiles vectorielles à l'indexation plutôt qu'à la demande.",
          "default": true
        },
        "skipUpload": {
          "type": "boolean",
          "title": "Simulation (aucun jeu de données créé ni modifié)",
          "description": "Télécharge, convertit et normalise les données sans créer ni mettre à jour de jeu de données.",
          "default": false
        }
      }
    }
  ]
}
