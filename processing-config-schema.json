{
  "type": "object",
  "layout": "tabs",
  "required": [
    "datasetMode"
  ],
  "$defs": {
    "level": {
      "type": "string",
      "title": "Niveau",
      "oneOf": [
        {
          "const": "region",
          "title": "Régions"
        },
        {
          "const": "departement",
          "title": "Départements"
        },
        {
          "const": "epci",
          "title": "EPCI"
        },
        {
          "const": "commune",
          "title": "Communes"
        },
        {
          "const": "arrondissement-municipal",
          "title": "Arrondissements municipaux"
        },
        {
          "const": "iris",
          "title": "IRIS"
        }
      ]
    },
    "simplifyLevel": {
      "type": "string",
      "title": "Simplification",
      "default": "medium",
      "oneOf": [
        {
          "const": "full",
          "title": "Aucune (tracés IGN d'origine)"
        },
        {
          "const": "precise",
          "title": "Précise (0,0001°, ~10 m)"
        },
        {
          "const": "medium",
          "title": "Moyenne (0,001°, ~100 m)"
        },
        {
          "const": "simple",
          "title": "Forte (0,01°, ~1 km)"
        }
      ]
    }
  },
  "allOf": [
    {
      "title": "Jeux de données",
      "properties": {
        "datasetMode": {
          "type": "string",
          "default": "create",
          "layout": "none"
        }
      },
      "discriminator": {
        "propertyName": "datasetMode"
      },
      "oneOfLayout": {
        "label": "Action"
      },
      "oneOf": [
        {
          "title": "Créer les jeux de données",
          "required": [
            "datasetMode"
          ],
          "properties": {
            "datasetMode": {
              "type": "string",
              "const": "create"
            },
            "datasetIdPrefix": {
              "type": "string",
              "title": "Préfixe des slugs",
              "default": "france-contours",
              "description": "Chaque jeu est créé avec le slug `<préfixe>-<millésime>-<niveau>-<simplification>` (ex : `france-contours-2026-commune-medium`). Si un jeu de données du compte porte déjà ce slug, il est réutilisé plutôt que dupliqué. Les jeux ne sont créés qu'une fois : la configuration bascule ensuite en mise à jour."
            },
            "createAll": {
              "type": "boolean",
              "title": "Tout créer (tous les niveaux dans toutes les simplifications)",
              "default": false,
              "description": "Pour un lancement initial : produit les 24 combinaisons niveau × simplification. Les tracés IRIS non simplifiés sont volumineux."
            },
            "datasets": {
              "type": "array",
              "title": "Jeux de données à créer",
              "description": "Une ligne par jeu de données. Un même niveau peut figurer plusieurs fois avec des simplifications différentes.",
              "layout": {
                "if": "!parent.data.createAll",
                "listEditMode": "inline",
                "messages": {
                  "addItem": "Ajouter un jeu de données"
                }
              },
              "default": [
                {
                  "level": "region",
                  "simplifyLevel": "medium"
                },
                {
                  "level": "departement",
                  "simplifyLevel": "medium"
                },
                {
                  "level": "epci",
                  "simplifyLevel": "medium"
                },
                {
                  "level": "commune",
                  "simplifyLevel": "medium"
                }
              ],
              "items": {
                "type": "object",
                "required": [
                  "level",
                  "simplifyLevel"
                ],
                "layout": [
                  {
                    "children": [
                      "level"
                    ],
                    "cols": 6
                  },
                  {
                    "children": [
                      "simplifyLevel"
                    ],
                    "cols": 6
                  }
                ],
                "properties": {
                  "level": {
                    "$ref": "#/$defs/level"
                  },
                  "simplifyLevel": {
                    "$ref": "#/$defs/simplifyLevel"
                  }
                }
              }
            }
          }
        },
        {
          "title": "Mettre à jour les jeux de données",
          "required": [
            "datasetMode"
          ],
          "properties": {
            "datasetMode": {
              "type": "string",
              "const": "update"
            },
            "datasets": {
              "type": "array",
              "title": "Jeux de données à mettre à jour",
              "description": "Une ligne par jeu de données, remplie automatiquement après la création. Le jeu est remplacé par le millésime choisi dans l'onglet Paramètres ; son slug ne change pas.",
              "layout": {
                "listEditMode": "inline",
                "messages": {
                  "addItem": "Ajouter un jeu de données"
                }
              },
              "items": {
                "type": "object",
                "required": [
                  "level",
                  "simplifyLevel",
                  "dataset"
                ],
                "layout": [
                  {
                    "children": [
                      "level"
                    ],
                    "cols": 3
                  },
                  {
                    "children": [
                      "simplifyLevel"
                    ],
                    "cols": 4
                  },
                  {
                    "children": [
                      "dataset"
                    ],
                    "cols": 5
                  }
                ],
                "properties": {
                  "level": {
                    "$ref": "#/$defs/level"
                  },
                  "simplifyLevel": {
                    "$ref": "#/$defs/simplifyLevel"
                  },
                  "dataset": {
                    "type": "object",
                    "title": "Jeu de données existant",
                    "required": [
                      "id"
                    ],
                    "layout": {
                      "getItems": {
                        "url": "${context.dataFairUrl}/api/v1/datasets?select=id,title&size=50&${context.ownerFilter}&raw=true",
                        "qSearchParam": "q",
                        "itemsResults": "data.results",
                        "itemTitle": "item.title",
                        "itemKey": "item.id"
                      }
                    },
                    "properties": {
                      "id": {
                        "type": "string",
                        "title": "Identifiant"
                      },
                      "title": {
                        "type": "string",
                        "title": "Titre"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "Paramètres",
      "properties": {
        "year": {
          "type": "integer",
          "title": "Millésime",
          "default": 2026,
          "description": "Livraisons ADMIN-EXPRESS-COG et CONTOURS-IRIS de l'IGN (Géoplateforme). Pour conserver plusieurs millésimes côte à côte, créez un traitement par millésime.",
          "enum": [
            2026,
            2025,
            2024,
            2023,
            2022,
            2021,
            2020,
            2019,
            2018,
            2017
          ]
        },
        "combineCommunesAndPlm": {
          "type": "boolean",
          "title": "Fusionner communes et arrondissements municipaux (PLM)",
          "description": "Pour le niveau commune, remplace les polygones de Paris, Lyon et Marseille par leurs arrondissements municipaux afin d'obtenir un découpage jointif sans superposition. La commune de rattachement est conservée dans la colonne `INSEE_RATT`.",
          "default": true
        },
        "enableVtPrepare": {
          "type": "boolean",
          "title": "Pré-calculer les tuiles vectorielles",
          "description": "Active la capacité `vtPrepare` sur la géométrie : Data Fair génère les tuiles vectorielles à l'indexation plutôt qu'à la demande.",
          "default": true
        },
        "skipUpload": {
          "type": "boolean",
          "title": "Simulation (aucun jeu de données créé ni modifié)",
          "description": "Télécharge, convertit et normalise les données sans créer ni mettre à jour de jeu de données.",
          "default": false
        }
      }
    }
  ]
}
